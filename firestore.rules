rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.token.email);
    }
    function registered() {
      return authenticated() && exists(userPath())
        && get(userPath()).data.role in ['admin', 'editor'];
    }
    function admin() {
      return registered() && get(userPath()).data.role == 'admin';
    }
    function canEditChapter(chapter) {
      return registered() && (admin()
        || (get(userPath()).data.role == 'editor'
          && chapter in get(userPath()).data.assignedChapters));
    }

    match /users/{email} {
      // Own-document reads remain possible after revocation so listeners can detect it.
      allow get: if authenticated() && (email == request.auth.token.email || admin());
      allow list: if admin();
      allow create, update: if admin()
        && request.resource.data.role in ['admin', 'editor']
        && request.resource.data.assignedChapters is list;
      allow delete: if admin();
    }

    match /drafts/{draftId} {
      function validDraft() {
        return request.resource.data.chapterId is string
          && request.resource.data.slug is string
          && request.resource.data.title is string
          && request.resource.data.contentMarkdown is string
          && request.resource.data.authorEmail is string
          && request.resource.data.status in ['draft', 'pending_approval', 'approved'];
      }
      allow get: if (resource.data.status == 'approved')
        || (registered() && (admin()
          || (!exists(/databases/$(database)/documents/drafts/$(draftId))
            && canEditChapter(draftId.split('_')[0]))
          || resource.data.authorEmail == request.auth.token.email
          || canEditChapter(resource.data.chapterId)));
      // Editors query their own drafts or drafts belonging to chapters assigned to them.
      allow list: if registered() && (admin()
        || resource.data.authorEmail == request.auth.token.email
        || canEditChapter(resource.data.chapterId));
      allow create: if validDraft() && (admin()
        || (canEditChapter(request.resource.data.chapterId)
          && request.resource.data.status in ['draft', 'pending_approval']));
      allow update: if validDraft() && (admin()
        || (canEditChapter(resource.data.chapterId)
          && request.resource.data.chapterId == resource.data.chapterId
          && request.resource.data.slug == resource.data.slug
          && (
            request.resource.data.status in ['draft', 'pending_approval']
            || (resource.data.status == 'approved'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'contentMarkdown']))
          )));
      allow delete: if admin();
    }

    match /published_subtopics/{subtopicId} {
      allow read: if true;
      allow write: if admin();
    }

    match /course/chapters {
      // The course has up to 13 chapters. Editors may change only sections of assigned chapters,
      // preserving chapter identity/order; admins can add/restructure chapters.
      function assignedOrUnchanged(index) {
        return index >= resource.data.list.size()
          || request.resource.data.list[index] == resource.data.list[index]
          || (request.resource.data.list[index].number == resource.data.list[index].number
            && request.resource.data.list[index].diff(resource.data.list[index]).affectedKeys().hasOnly(['sections'])
            && canEditChapter(resource.data.list[index].number)
            && request.resource.data.list[index].sections.size() >= resource.data.list[index].sections.size());
      }
      allow read: if true;
      allow create, delete: if admin();
      allow update: if admin() || (registered()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['list', 'updatedAt'])
        && request.resource.data.list is list
        && request.resource.data.list.size() == resource.data.list.size()
        && resource.data.list.size() <= 13
        && assignedOrUnchanged(0) && assignedOrUnchanged(1) && assignedOrUnchanged(2)
        && assignedOrUnchanged(3) && assignedOrUnchanged(4) && assignedOrUnchanged(5)
        && assignedOrUnchanged(6) && assignedOrUnchanged(7) && assignedOrUnchanged(8)
        && assignedOrUnchanged(9) && assignedOrUnchanged(10) && assignedOrUnchanged(11)
        && assignedOrUnchanged(12));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
