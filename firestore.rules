rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.token.email);
    }
    function registered() {
      return authenticated() && exists(userPath())
        && get(userPath()).data.role in ['admin', 'editor'];
    }
    function admin() {
      return registered() && get(userPath()).data.role == 'admin';
    }
    function canEditChapter(chapter) {
      return registered() && (admin()
        || (get(userPath()).data.role == 'editor'
          && chapter in get(userPath()).data.assignedChapters));
    }

    match /users/{email} {
      // Own-document reads remain possible after revocation so listeners can detect it.
      allow get: if authenticated() && (email == request.auth.token.email || admin());
      allow list: if admin();
      allow create, update: if admin()
        && request.resource.data.role in ['admin', 'editor']
        && request.resource.data.assignedChapters is list;
      allow delete: if admin();
    }

    match /drafts/{draftId} {
      function validDraft() {
        return request.resource.data.chapterId is string
          && request.resource.data.slug is string
          && request.resource.data.title is string
          && request.resource.data.contentMarkdown is string
          && request.resource.data.authorEmail is string
          && request.resource.data.status in ['draft', 'pending_approval', 'approved'];
      }
      allow read: if true;
      allow create: if validDraft() && (admin()
        || (canEditChapter(request.resource.data.chapterId)
          && request.resource.data.status in ['draft', 'pending_approval']));
      allow update: if validDraft() && (admin()
        || (canEditChapter(resource.data.chapterId)
          && request.resource.data.chapterId == resource.data.chapterId
          && request.resource.data.slug == resource.data.slug
          && (
            request.resource.data.status in ['draft', 'pending_approval']
            || (resource.data.status == 'approved'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'contentMarkdown']))
          )));
      allow delete: if admin()
        || (canEditChapter(resource.data.chapterId) && resource.data.status != 'approved');
    }

    match /course/chapters {
      // A single assigned chapter may change; all other entries and their order
      // must remain identical, regardless of how many chapters the course has.
      function assignedChapterOnly() {
        let index = request.resource.data.editedChapterIndex;
        let previous = resource.data.list[index];
        let next = request.resource.data.list[index];
        return index is int && index >= 0 && index < resource.data.list.size()
          && canEditChapter(previous.number)
          && previous.get('archived', false) == false
          && next.diff(previous).affectedKeys().hasOnly(['sections'])
          && next.sections is list
          && resource.data.list.removeAll([previous]) == request.resource.data.list.removeAll([next]);
      }
      allow read: if true;
      allow create, delete: if admin();
      allow update: if admin() || (registered()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['list', 'updatedAt', 'editedChapterIndex'])
        && request.resource.data.list is list
        && request.resource.data.list.size() == resource.data.list.size()
        && assignedChapterOnly());
    }

    match /exams/{examId} {
      allow read: if true;
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['period', 'type', 'title', 'contentMarkdown'])
        && request.resource.data.period is string
        && request.resource.data.period.matches('^[0-9]{4}-[12]$')
        && request.resource.data.type in ['practica', 'parcial', 'final', 'sustitutorio']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.contentMarkdown is string
        && request.resource.data.contentMarkdown.size() > 0
        && request.resource.data.contentMarkdown.size() <= 200000;
      allow delete: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
