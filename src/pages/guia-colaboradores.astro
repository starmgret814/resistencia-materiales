---
export const prerender = true;
import Layout from '@/src/layouts/Layout.astro';
import { ArrowRight, Copy, Eye, History, ImageUp } from 'lucide-react';
import { imageTableSnippet } from '@/lib/table-snippets';
---

<Layout title="Guía para Colaboradores | Resistencia de Materiales — UNI" description="Manual práctico para redactores y colaboradores del espacio digital de estudio de Resistencia de Materiales">
  <div class="min-h-screen bg-[#faf5f3] dark:bg-[#140b0c] text-[#4d3838] dark:text-[#f2e1df]">
    <!-- Cabecera de la guía -->
    <header class="sticky top-0 z-40 border-b border-[#e3caca] dark:border-[#382022] bg-[#fbf7f4]/95 dark:bg-[#1a0f10]/95 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-4 sm:px-6">
        <div class="flex items-center gap-3">
          <a href="/workspace-mc361/content/chapters" class="flex items-center gap-2 text-[#7f0303] dark:text-[#f87171] hover:opacity-80 transition-opacity">
            <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
            </svg>
            <span class="font-sans font-bold text-base sm:text-lg tracking-tight">MC361</span>
          </a>
          <span class="text-[#c5a6a6] dark:text-[#522c2f]">/</span>
          <span class="font-sans text-sm sm:text-base font-semibold text-[#4a1719] dark:text-[#f7dfdd]">Guía para Colaboradores</span>
        </div>
        <div class="flex items-center gap-2">
          <a href="/workspace-mc361/content/chapters" class="inline-flex items-center gap-1.5 rounded-lg border border-[#d5baba] dark:border-[#4d282b] bg-white dark:bg-[#201012] px-3 py-1.5 text-xs font-semibold text-[#7f0303] dark:text-[#fca5a5] hover:bg-[#f8eaea] dark:hover:bg-[#2e1619] transition-colors shadow-sm">
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
            </svg>
            <span>Ir al Panel</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Contenido principal -->
    <main class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:py-14">
      <!-- Añadir las próximas actualizaciones arriba, con fecha y enlaces a las instrucciones. Conservar las entradas anteriores. -->
      <section id="novedades" aria-labelledby="novedades-titulo" class="mb-8 scroll-mt-24 rounded-xl border border-[#d5baba] bg-white p-5 sm:p-7 dark:border-[#4d282b] dark:bg-[#1a0f10]">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <h1 id="novedades-titulo" class="flex items-center gap-2.5 font-sans text-xl font-bold text-[#4a1719] sm:text-2xl dark:text-[#f7dfdd]"><History size={22} className="shrink-0 text-[#8B0000] dark:text-[#fca5a5]" aria-hidden="true" />Novedades para colaboradores</h1>
            <p class="mt-2 max-w-xl text-sm leading-relaxed text-[#765e5e] dark:text-[#cbb0ae]">¿Ya conoces la guía? Revisa aquí los cambios recientes y abre solo las instrucciones que necesites.</p>
          </div>
          <a href="#guia-completa" class="inline-flex items-center gap-1.5 rounded-md py-1 text-xs font-semibold text-[#7f0303] hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 dark:text-[#fca5a5]">Ir a la guía completa <ArrowRight size={15} aria-hidden="true" /></a>
        </div>
        <details open class="mt-5 border-t border-[#ead5d4] pt-4 dark:border-[#382022]">
          <summary class="cursor-pointer text-sm font-semibold text-[#7f0303] dark:text-[#fca5a5]"><time datetime="2026-11-22">22 de noviembre de 2026</time> · Subir imágenes e insertar su enlace</summary>
          <p class="mt-4 text-sm leading-6 text-[#5f4445] dark:text-[#d9c4c2]">La barra del editor de capítulos incluye <strong>Subir imagen e insertar enlace</strong>, junto al botón de imagen. Coloca el cursor, selecciona el archivo y la URL se insertará en el documento, sin panel ni acción de copia. <a href="#guia-imagen-enlace" class="font-semibold text-[#7f0303] underline underline-offset-4 dark:text-[#fca5a5]">Ver cómo usarla</a>.</p>
        </details>
        <details class="mt-5 border-t border-[#ead5d4] pt-4 dark:border-[#382022]">
          <summary class="cursor-pointer text-sm font-semibold text-[#7f0303] dark:text-[#fca5a5]"><time datetime="2026-11-22">22 de noviembre de 2026</time> · Imágenes sin borde y títulos de tablas</summary>
          <ul class="mt-4 space-y-3 text-sm leading-6 text-[#5f4445] dark:text-[#d9c4c2]">
            <li><strong>Imágenes sin borde.</strong> Añade <code>border="false"</code> a <code>&lt;Image /&gt;</code>. Para la figura lateral de un problema, usa <code>imageBorder="false"</code>. Si no indicas esta opción, se mantiene el borde habitual. <a href="#guia-imagenes" class="font-semibold text-[#7f0303] underline underline-offset-4 dark:text-[#fca5a5]">Ver instrucciones y ejemplo</a>.</li>
            <li><strong>Títulos tal como los escribes.</strong> Las cabeceras y el título de una tabla conservan las mayúsculas y minúsculas originales. Puedes escribir «Tipo de carga», «TIPO DE CARGA» o combinar estilos en columnas distintas; ya no se convierten automáticamente a mayúsculas.</li>
            <li><strong>Tipografía académica uniforme.</strong> Las celdas, cabeceras, títulos y leyendas de imágenes dentro de tablas usan la misma fuente y tamaño del texto del capítulo. No necesitas agregar una opción para igualarlos.</li>
          </ul>
        </details>
        <details class="mt-5 border-t border-[#ead5d4] pt-4 dark:border-[#382022]">
          <summary class="cursor-pointer text-sm font-semibold text-[#7f0303] dark:text-[#fca5a5]"><time datetime="2026-11-22">22 de noviembre de 2026</time> · Tablas con imágenes y fórmulas editables</summary>
          <p class="mt-4 text-sm leading-6 text-[#5f4445] dark:text-[#d9c4c2]">Usa <strong>Insertar componente → Tabla con imágenes</strong> para combinar dibujos, texto y LaTeX en celdas nativas. Puedes ajustar el tamaño de las imágenes y el ancho mínimo de la tabla. <a href="#guia-tablas-imagenes" class="font-semibold text-[#7f0303] underline underline-offset-4 dark:text-[#fca5a5]">Ver ejemplo y opciones</a>.</p>
        </details>
        <details class="mt-5 border-t border-[#ead5d4] pt-4 dark:border-[#382022]">
          <summary class="cursor-pointer text-sm font-semibold text-[#7f0303] dark:text-[#fca5a5]"><time datetime="2026-11-18">18 de noviembre de 2026</time> · Historial del editor y gestión de subtemas</summary>
          <ul class="mt-4 space-y-3 text-sm leading-6 text-[#5f4445] dark:text-[#d9c4c2]">
            <li><strong>Deshacer y rehacer.</strong> El editor conserva su historial al ampliar la vista previa. Las inserciones e importaciones son pasos deshacibles. Usa Ctrl + Z para deshacer y Ctrl + Y o Ctrl + Shift + Z para rehacer; en Mac, Command + Z y Command + Shift + Z.</li>
            <li><strong>Ediciones simultáneas.</strong> Al añadir, renombrar u ordenar subtemas de tus capítulos asignados, se conserva el trabajo de otras personas y las direcciones existentes. Si la operación falla, se conserva el estado anterior.</li>
          </ul>
        </details>
        <details class="mt-5 border-t border-[#ead5d4] pt-4 dark:border-[#382022]">
          <summary class="cursor-pointer text-sm font-semibold text-[#7f0303] dark:text-[#fca5a5]"><time datetime="2026-11-15">15 de noviembre de 2026</time> · Puesta al día del editor y los contenidos</summary>
          <ul class="mt-4 space-y-3 text-sm leading-6 text-[#5f4445] dark:text-[#d9c4c2]">
            <li><strong>Respaldo local del trabajo.</strong> Los editores conservan una copia mientras escribes, sin servicios adicionales. Al volver puedes revisar y recuperar el texto pendiente. <a href="#guia-respaldo" class="font-semibold text-[#7f0303] underline underline-offset-4 dark:text-[#fca5a5]">Cómo funciona la recuperación</a>.</li>
            <li><strong>Ejemplos para copiar y probar.</strong> Cada bloque de código de esta guía tiene <strong>Copiar</strong> y <strong>Ver resultado</strong>. <a href="#guia-ejemplos" class="font-semibold text-[#7f0303] underline underline-offset-4 dark:text-[#fca5a5]">Probar los ejemplos</a>.</li>
            <li><strong>Edición en pantallas pequeñas.</strong> Alterna entre <strong>Editar</strong> y <strong>Vista previa</strong> para aprovechar el espacio. Los simuladores tienen controles más cómodos de tocar.</li>
            <li><strong>Ecuaciones y referencias.</strong> Usa <code>Formula</code> con <code>number</code>, <code>boxed="true"</code> y <code>bold="true"</code>. Puedes enlazar ecuaciones y figuras desde el texto. <a href="#guia-formulas" class="font-semibold text-[#7f0303] underline underline-offset-4 dark:text-[#fca5a5]">Ver formato de ecuaciones</a>.</li>
            <li><strong>Términos con explicación.</strong> Añade <code>Term definition="..."</code> para mostrar una definición al pasar el cursor, enfocar o tocar el término. <a href="#guia-referencias" class="font-semibold text-[#7f0303] underline underline-offset-4 dark:text-[#fca5a5]">Copiar ejemplos de términos y referencias</a>.</li>
            <li><strong>Problemas con imágenes.</strong> La numeración es automática por capítulo. Usa <code>imageLayout="auto"</code>, <code>"wrap"</code> o <code>"stacked"</code> para acomodar la figura sin estrechar demasiado el enunciado. <a href="#guia-problemas" class="font-semibold text-[#7f0303] underline underline-offset-4 dark:text-[#fca5a5]">Ver opciones de problemas</a>.</li>
            <li><strong>Tablas personalizables.</strong> Puedes definir alineación, ancho y tamaños de columna, o usar <code>TableGrid</code> para colocar varias tablas en una fila. <a href="#guia-tablas" class="font-semibold text-[#7f0303] underline underline-offset-4 dark:text-[#fca5a5]">Ver ejemplos de tablas</a>.</li>
            <li><strong>Herramientas interactivas.</strong> Inserta los simuladores de Mohr, esfuerzo normal o deformación axial desde <strong>Insertar componente</strong>. <a href="#guia-herramientas" class="font-semibold text-[#7f0303] underline underline-offset-4 dark:text-[#fca5a5]">Ver herramientas disponibles</a>.</li>
          </ul>
          <p class="mt-4 rounded-lg bg-[#fbf2f0] px-3 py-2 text-xs leading-6 text-[#765e5e] dark:bg-[#241215] dark:text-[#cbb0ae]">Puedes incorporar estas opciones al adaptar tu capítulo; no necesitas reescribir todo el material. La autoría de las presentaciones originales corresponde al <strong>Ing. Eden Angel Molina Capcha</strong>.</p>
        </details>
      </section>

      <!-- Aviso inicial destacado -->
      <div class="mb-10 rounded-2xl border-2 border-[#8B0000]/25 dark:border-[#f87171]/30 bg-[#fbf2f0] dark:bg-[#241215] p-5 sm:p-6 shadow-sm">
        <div class="flex items-start gap-3 sm:gap-4">
          <div class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-[#8B0000] text-white shadow-md shadow-[#8B0000]/20">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
            </svg>
          </div>
          <div>
            <h2 class="font-sans text-lg font-bold text-[#6a1518] dark:text-[#fca5a5]">No necesitas conocimientos técnicos previos</h2>
            <p class="mt-1.5 text-sm sm:text-base leading-relaxed text-[#5c3e3e] dark:text-[#e4cccc]">
              <strong>No necesitas instalar ningún programa ni conocer Git, GitHub o programación.</strong> Puedes redactar, dar formato, guardar avances y enviar tu contenido a revisión desde el navegador.
            </p>
          </div>
        </div>
      </div>

      <div id="guia-completa" class="max-w-none scroll-mt-24 space-y-12">

        <!-- 1. Bienvenida -->
        <section class="rounded-xl border border-[#ead5d4] dark:border-[#382022] bg-white dark:bg-[#1a0f10] p-6 sm:p-8 shadow-sm">
          <div class="flex items-center gap-2.5 text-[#8B0000] dark:text-[#f87171]">
            <span class="flex size-7 items-center justify-center rounded-full bg-[#f6e5e5] dark:bg-[#341619] font-mono text-xs font-bold">1</span>
            <h2 class="font-sans text-2xl font-bold text-[#4a1719] dark:text-[#f7dfdd] m-0">Bienvenida</h2>
          </div>
          <div class="mt-4 space-y-3 text-[15px] leading-relaxed text-[#5f4445] dark:text-[#d9c4c2]">
            <p>
              <strong>¿En qué consiste?</strong> Es un espacio digital de estudio desarrollado para los estudiantes del curso <strong>Resistencia de Materiales (MC361)</strong> de la <strong>Universidad Nacional de Ingeniería (UNI)</strong>. Su objetivo es brindar explicaciones conceptuales claras, fórmulas matemáticas en alta resolución, esquemas técnicos y problemas resueltos paso a paso.
            </p>
            <p>
              <strong>¿Qué debe hacer el colaborador?</strong>
            </p>
            <ul class="list-disc pl-5 space-y-1.5">
              <li>Redactar y actualizar los temas teóricos de los capítulos asignados.</li>
              <li>Incorporar fórmulas matemáticas y figuras explicativas claras.</li>
              <li>Proponer ejemplos prácticos resueltos y preguntas de autoevaluación.</li>
              <li>Asegurar que la notación, unidades y rigor correspondan al estándar académico de la UNI.</li>
            </ul>
          </div>
        </section>

        <!-- 2. Acceso y editor -->
        <section class="rounded-xl border border-[#ead5d4] dark:border-[#382022] bg-white dark:bg-[#1a0f10] p-6 sm:p-8 shadow-sm">
          <div class="flex items-center gap-2.5 text-[#8B0000] dark:text-[#f87171]">
            <span class="flex size-7 items-center justify-center rounded-full bg-[#f6e5e5] dark:bg-[#341619] font-mono text-xs font-bold">2</span>
            <h2 class="font-sans text-2xl font-bold text-[#4a1719] dark:text-[#f7dfdd] m-0">Acceso y editor</h2>
          </div>
          <div class="mt-4 grid gap-3 sm:grid-cols-2 text-sm text-[#5f4445] dark:text-[#d9c4c2]">
            <div class="rounded-lg border border-[#f0dedd] dark:border-[#331c1e] bg-[#faf6f5] dark:bg-[#1e1113] p-4">
              <p class="font-bold text-[#7f0303] dark:text-[#fca5a5]">1. Cómo entrar</p>
              <p class="mt-1">Pulsa «Continuar con Google» en la página de acceso y utiliza la cuenta que tienes autorizada en la plataforma.</p>
            </div>
            <div class="rounded-lg border border-[#f0dedd] dark:border-[#331c1e] bg-[#faf6f5] dark:bg-[#1e1113] p-4">
              <p class="font-bold text-[#7f0303] dark:text-[#fca5a5]">2. Cómo abrir un capítulo</p>
              <p class="mt-1">En el panel principal verás la lista de capítulos. Haz clic en el subtema asignado para comenzar.</p>
            </div>
            <div class="rounded-lg border border-[#f0dedd] dark:border-[#331c1e] bg-[#faf6f5] dark:bg-[#1e1113] p-4">
              <p class="font-bold text-[#7f0303] dark:text-[#fca5a5]">3. Cómo escribir</p>
              <p class="mt-1">En el panel izquierdo redacta tu contenido en formato Markdown con ayuda de los botones superiores.</p>
            </div>
            <div class="rounded-lg border border-[#f0dedd] dark:border-[#331c1e] bg-[#faf6f5] dark:bg-[#1e1113] p-4">
              <p class="font-bold text-[#7f0303] dark:text-[#fca5a5]">4. Vista previa</p>
              <p class="mt-1">En el panel derecho verás en vivo cómo se renderiza exactamente tu tema con los estilos finales.</p>
            </div>
            <div class="rounded-lg border border-[#f0dedd] dark:border-[#331c1e] bg-[#faf6f5] dark:bg-[#1e1113] p-4">
              <p class="font-bold text-[#7f0303] dark:text-[#fca5a5]">5. Guardar avance</p>
              <p class="mt-1">Haz clic en <strong>Guardar Avance</strong> periódicamente para respaldar tu progreso sin publicar aún.</p>
            </div>
            <div class="rounded-lg border border-[#f0dedd] dark:border-[#331c1e] bg-[#faf6f5] dark:bg-[#1e1113] p-4">
              <p class="font-bold text-[#7f0303] dark:text-[#fca5a5]">6. Enviar a revisión</p>
              <p class="mt-1">Al finalizar, pulsa <strong>Solicitar Revisión</strong> para que el administrador revise y publique tu contenido.</p>
            </div>
          </div>
        </section>


        <section id="guia-respaldo" aria-labelledby="guia-respaldo-titulo" class="scroll-mt-24 rounded-xl border border-[#ead5d4] bg-white p-6 shadow-sm sm:p-8 dark:border-[#382022] dark:bg-[#1a0f10]">
          <h2 id="guia-respaldo-titulo" class="font-sans text-2xl font-bold text-[#4a1719] dark:text-[#f7dfdd]">Respaldo local y recuperación</h2>
          <div class="mt-4 space-y-3 text-sm leading-6 text-[#5f4445] dark:text-[#d9c4c2]">
            <p>El editor de capítulos guarda una copia local después de una pausa al escribir. Cada copia corresponde a tu cuenta y documento; este respaldo no envía el texto a Firestore ni publica cambios.</p>
            <p>Al volver al mismo documento, si hay una copia distinta de la versión cargada, verás un aviso. Puedes consultar su texto y pulsar <strong>Recuperar copia</strong>. Después, usa <strong>Guardar Avance</strong>, solicita revisión cuando esté listo.</p>
            <p>La copia está solo en <strong>ese navegador y dispositivo</strong>. Puede perderse al borrar sus datos o salir de una sesión privada. No reemplaza el guardado en la plataforma. Para conservar un archivo independiente, usa <strong>Exportar MD</strong> en el editor.</p>
            <p>Si el navegador bloquea el almacenamiento o se queda sin espacio, el editor lo indica para que puedas descargar el texto o guardarlo manualmente.</p>
          </div>
        </section>


        <section id="guia-subtemas" class="scroll-mt-24 rounded-xl border border-[#ead5d4] bg-white p-6 shadow-sm sm:p-8 dark:border-[#382022] dark:bg-[#1a0f10]">
          <h2 class="font-sans text-2xl font-bold text-[#4a1719] dark:text-[#f7dfdd]">Organizar los subtemas asignados</h2>
          <p class="mt-4 text-sm leading-6 text-[#5f4445] dark:text-[#d9c4c2]">Puedes añadir, renombrar y ordenar subtemas dentro de tus capítulos asignados. Revisa el título antes de guardar. La eliminación de un subtema ya publicado requiere solicitar ayuda al responsable de la publicación.</p>
          <p class="mt-3 text-sm leading-6 text-[#765e5e] dark:text-[#cbb0ae]">Ctrl + Z revierte texto mientras el editor permanece abierto. No deshace cambios ya guardados en la estructura del curso ni publicaciones.</p>
        </section>

        <!-- 3. Markdown básico -->
        <section class="rounded-xl border border-[#ead5d4] dark:border-[#382022] bg-white dark:bg-[#1a0f10] p-6 sm:p-8 shadow-sm">
          <div class="flex items-center gap-2.5 text-[#8B0000] dark:text-[#f87171]">
            <span class="flex size-7 items-center justify-center rounded-full bg-[#f6e5e5] dark:bg-[#341619] font-mono text-xs font-bold">3</span>
            <h2 class="font-sans text-2xl font-bold text-[#4a1719] dark:text-[#f7dfdd] m-0">Markdown básico</h2>
          </div>
          <p class="mt-2 text-sm text-[#7a5c5c] dark:text-[#af9795]">El formato de texto es muy intuitivo y estándar:</p>
          <div class="mt-4 overflow-x-auto rounded-lg border border-[#ead5d4] dark:border-[#382022]">
            <table class="w-full text-left text-sm">
              <thead class="bg-[#fbf2f0] dark:bg-[#251316] text-[#6b1e22] dark:text-[#fca5a5] border-b border-[#ead5d4] dark:border-[#382022]">
                <tr>
                  <th class="py-3 px-4 font-bold">Elemento</th>
                  <th class="py-3 px-4 font-bold">Cómo escribirlo</th>
                  <th class="py-3 px-4 font-bold">Uso</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#f2e1e0] dark:divide-[#2e191b] text-[#553b3c] dark:text-[#d3bcbb]">
                <tr>
                  <td class="py-2.5 px-4 font-semibold">Título principal</td>
                  <td class="py-2.5 px-4 font-mono text-xs text-[#7f0303] dark:text-[#fca5a5]"># Título</td>
                  <td class="py-2.5 px-4">Solo uno al inicio de cada subtema.</td>
                </tr>
                <tr>
                  <td class="py-2.5 px-4 font-semibold">Subtítulo</td>
                  <td class="py-2.5 px-4 font-mono text-xs text-[#7f0303] dark:text-[#fca5a5]">## Fundamento</td>
                  <td class="py-2.5 px-4">Secciones principales de la lección.</td>
                </tr>
                <tr>
                  <td class="py-2.5 px-4 font-semibold">Apartado</td>
                  <td class="py-2.5 px-4 font-mono text-xs text-[#7f0303] dark:text-[#fca5a5]">### Hipótesis</td>
                  <td class="py-2.5 px-4">Subdivisiones de un tema.</td>
                </tr>
                <tr>
                  <td class="py-2.5 px-4 font-semibold">Negrita</td>
                  <td class="py-2.5 px-4 font-mono text-xs text-[#7f0303] dark:text-[#fca5a5]">**texto**</td>
                  <td class="py-2.5 px-4">Resalta palabras clave y conceptos.</td>
                </tr>
                <tr>
                  <td class="py-2.5 px-4 font-semibold">Cursiva</td>
                  <td class="py-2.5 px-4 font-mono text-xs text-[#7f0303] dark:text-[#fca5a5]">*texto*</td>
                  <td class="py-2.5 px-4">Términos en otros idiomas o variables.</td>
                </tr>
                <tr>
                  <td class="py-2.5 px-4 font-semibold">Lista numerada</td>
                  <td class="py-2.5 px-4 font-mono text-xs text-[#7f0303] dark:text-[#fca5a5]">1. Paso uno<br />2. Paso dos</td>
                  <td class="py-2.5 px-4">Secuencias metódicas de solución.</td>
                </tr>
                <tr>
                  <td class="py-2.5 px-4 font-semibold">Viñetas</td>
