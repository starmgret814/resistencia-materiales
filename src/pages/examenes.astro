---
import Layout from '@/src/layouts/Layout.astro';
import TextbookLayout from '@/components/textbook-layout';
import ExamArchive from '@/components/exam-archive';
---

<Layout title="Exámenes pasados | Resistencia de Materiales — UNI" description="Practica con evaluaciones de Resistencia de Materiales: prácticas calificadas, parciales, finales y sustitutorios organizados por periodo académico.">
  <TextbookLayout activeSlug={null} variant="archive" client:load>
    <div>
      <div class="border-b border-[#e3caca] pb-7 dark:border-[#382022]">
        <p class="mb-3 text-[10px] font-bold uppercase tracking-[0.2em] text-[#967070] dark:text-[#ab8e8e]">Archivo académico · MC361</p>
        <h1 class="font-serif text-3xl font-semibold tracking-tight text-[#4b1719] sm:text-4xl dark:text-[#f5dedd]">Exámenes pasados</h1>
        <p class="mt-3 max-w-xl text-sm leading-7 text-[#765e5e] dark:text-[#cbb0ae]">Un espacio para practicar lo aprendido. Explora las evaluaciones por periodo y encuentra el siguiente problema para resolver.</p>
      </div>
      <ExamArchive client:load />
    </div>
  </TextbookLayout>
</Layout>
