---
import Layout from '@/src/layouts/Layout.astro';
import TextbookLayout from '@/components/textbook-layout';
import ContentRenderer from '@/components/content-renderer';
import { findSectionBySlug } from '@/lib/course-data';
import { getLiveChapters, getApprovedSubtopic } from '@/lib/course-service';
import { mdxComponents } from '@/components/mdx-components';
import { ContentProvider } from '@/lib/content-context';

const { slug } = Astro.params;

// 1. Cargar el temario en vivo desde Firestore (con respaldo estático)
const liveChapters = await getLiveChapters();
const allLiveSections = liveChapters.flatMap((ch) =>
  ch.sections.map((sec) => ({ ...sec, chapterNumber: ch.number, chapterTitle: ch.title }))
);

const sectionIndex = allLiveSections.findIndex((s) => {
  if (!s.slug) return s.id === slug;
  return s.slug === slug || s.slug.split('/').pop() === slug || s.id === slug;
});

let sectionData: any = null;
if (sectionIndex !== -1) {
  sectionData = {
    section: allLiveSections[sectionIndex],
    previous: sectionIndex > 0 ? allLiveSections[sectionIndex - 1] : null,
    next: sectionIndex < allLiveSections.length - 1 ? allLiveSections[sectionIndex + 1] : null,
  };
} else {
  sectionData = findSectionBySlug(slug!);
}

if (!sectionData) {
  return Astro.redirect('/404');
}

const { section, previous, next } = sectionData;

// 2. Intentar cargar el contenido aprobado directamente de Firestore (Single Source of Truth)
const rawSlug = section.slug?.includes('/') ? section.slug.split('/').pop()! : (section.slug || section.id);
const approvedDoc = await getApprovedSubtopic(section.chapterNumber, rawSlug);

let Content = null;
let mappedHeadings: { level: number; id: string; text: string }[] = [];

if (approvedDoc && approvedDoc.contentMarkdown) {
  // Extraer encabezados de Markdown para el índice "En esta página"
  const regex = /^(#{2,3})\s+(.+)$/gm;
  let match;
  while ((match = regex.exec(approvedDoc.contentMarkdown)) !== null) {
    mappedHeadings.push({
      level: match[1].length,
      id: match[2].toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, ''),
      text: match[2].trim(),
    });
  }
} else {
  // Respaldo secundario: Si no está en Firestore todavía, buscar archivo estático .mdx en disco
  const mdxFiles = import.meta.glob('/src/content/resistencia/**/*.{mdx,md}', { eager: true });
  const exactPathMdx = `/src/content/resistencia/${slug}/index.mdx`;
  const exactPathMd = `/src/content/resistencia/${slug}/index.md`;
  const fallbackPathMdx = `/src/content/resistencia/${slug}.mdx`;
  const fallbackPathMd = `/src/content/resistencia/${slug}.md`;

  const targetModule = (mdxFiles[exactPathMdx] || mdxFiles[exactPathMd] || mdxFiles[fallbackPathMdx] || mdxFiles[fallbackPathMd]) as any;

  if (targetModule) {
    Content = targetModule.default;
    const headings = targetModule.getHeadings?.() || [];
    mappedHeadings = headings.map((h: any) => ({
      level: h.depth,
      id: h.slug,
      text: h.text,
    }));
  }
}
---

<Layout title={`${section.title} | Resistencia de Materiales — UNI`} description={`Capítulo ${section.chapterNumber}: ${section.chapterTitle}`}>
  <ContentProvider slug={slug as string} client:load>
    <TextbookLayout
      client:load
      activeSlug={slug as string}
      chapterNumber={section.chapterNumber}
      chapterTitle={section.chapterTitle}
      sectionTitle={section.title}
      headings={mappedHeadings}
      previous={previous as any}
      next={next as any}
      customChapters={liveChapters}
    >
      {approvedDoc ? (
        <ContentRenderer
          client:load
          document={{
            schemaVersion: 2,
            title: approvedDoc.title,
            chapterId: approvedDoc.chapterId,
            slug: approvedDoc.slug,
            contentMarkdown: approvedDoc.contentMarkdown,
          }}
        />
      ) : Content ? (
        <Content components={{ ...mdxComponents, Image: (props: any) => mdxComponents.Image({ ...props, slug: slug as string }) }} />
      ) : (
        <div class="flex min-h-[40vh] items-center justify-center rounded-xl border border-dashed border-[#d9aaaa] bg-[#faf0ef] p-10 text-center text-[#765e5e]">
          <div>
            <div class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-[#f8eaea]">
              <svg class="size-6 text-[#a34a4a]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.54 15H17a2 2 0 0 0-2 2v4.54"/><path d="M7 3.34V5a3 3 0 0 0 3 3a2 2 0 0 1 2 2c0 1.1.9 2 2 2a2 2 0 0 0 2-2c0-1.1.9-2 2-2h3.17"/><path d="M11 21.95V18a2 2 0 0 0-2-2a2 2 0 0 1-2-2v-1a2 2 0 0 0-2-2H2.05"/><circle cx="12" cy="12" r="10"/></svg>
            </div>
            <h2 class="text-lg font-semibold text-[#4b1719]">Próximamente</h2>
            <p class="mt-2 text-sm">Este tema aún no tiene contenido publicado. ¡Vuelve pronto!</p>
          </div>
        </div>
      )}
    </TextbookLayout>
  </ContentProvider>
</Layout>
