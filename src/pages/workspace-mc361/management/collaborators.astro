---
import Layout from '@/src/layouts/Layout.astro';
import WorkspaceHeader from '@/src/components/WorkspaceHeader.astro';
import UserManagement from '@/components/user-management';

const session = Astro.locals.session;

if (!session || session.role !== 'admin') {
  return Astro.redirect('/workspace-mc361/login')
}
---

<Layout title="Colaboradores | Resistencia de Materiales">
  <div class="min-h-screen bg-[#f8f5f4]">
    <WorkspaceHeader session={session} />
    <main>
      <UserManagement currentUserEmail={session.email} client:only="react" />
    </main>
  </div>
</Layout>
