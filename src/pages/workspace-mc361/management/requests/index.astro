---
import Layout from '@/src/layouts/Layout.astro';
import WorkspaceHeader from '@/src/components/WorkspaceHeader.astro';
import RequestsDashboard from '@/components/requests-dashboard';

const session = Astro.locals.session;

if (!session || session.role !== 'admin') {
  return Astro.redirect('/workspace-mc361/login')
}
---

<Layout title="Solicitudes | Resistencia de Materiales">
  <div class="min-h-screen bg-[#f8f5f4]">
    <WorkspaceHeader session={session} />
    <main>
      <RequestsDashboard client:only="react" />
    </main>
  </div>
</Layout>
