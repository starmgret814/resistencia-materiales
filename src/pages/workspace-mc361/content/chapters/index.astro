---
import Layout from '@/src/layouts/Layout.astro'
import DashboardComponent from '@/components/dashboard'
import WorkspaceHeader from '@/src/components/WorkspaceHeader.astro'

const session = Astro.locals.session;

if (!session) {
  return Astro.redirect('/workspace-mc361/login')
}

---

<Layout title="Proyectos | Editor MC361">
  <div class="min-h-screen bg-[#f8f5f4]">
    <WorkspaceHeader session={session} />
    <main>
      <DashboardComponent session={session} client:load />
    </main>
  </div>

</Layout>
