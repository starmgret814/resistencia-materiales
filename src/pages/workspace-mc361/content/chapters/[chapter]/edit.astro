---
import Layout from '@/src/layouts/Layout.astro';
import ContentEditor from '@/components/content-editor';

const sessionCookie = Astro.cookies.get('session_token');
let sessionData = null;
if (sessionCookie) {
  try {
    sessionData = JSON.parse(sessionCookie.value);
  } catch (e) {}
}
const { chapter } = Astro.params;
const slug = Astro.url.searchParams.get('slug')

// Si no hay capítulo o slug, redirigir al listado
if (!chapter || !slug) {
  return Astro.redirect('/workspace-mc361/content/chapters');
}
---

<Layout title="Editor de contenido | Resistencia de Materiales" description="Editor y vista previa de páginas del curso">
  <ContentEditor session={sessionData} initialChapter={chapter} initialSlug={slug} client:only="react" />
</Layout>
